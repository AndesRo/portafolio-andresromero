# Copia este archivo a .env y completa con tus credenciales de Supabase
# (Project Settings → API en tu dashboard de Supabase)
#
# Si dejas estas variables vacías o no creas el archivo .env,
# el portafolio funciona igual usando los proyectos locales de
# src/data/profile.js — no se rompe nada.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
